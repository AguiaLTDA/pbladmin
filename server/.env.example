PORT=4000

# Supabase Postgres (Settings > Database > Connection string, use o Session pooler)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# Google Drive (conta de serviço com acesso a um Drive Compartilhado do Workspace)
# Dev local: baixe o JSON da conta de serviço no Google Cloud Console e aponte o caminho aqui.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# Produção (Render e afins, sem disco persistente para um arquivo): cole o CONTEÚDO
# inteiro do JSON aqui (uma linha só). Quando definida, tem prioridade sobre o arquivo acima.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Id da pasta (dentro do Drive Compartilhado) onde os arquivos serão gravados.
GOOGLE_DRIVE_FOLDER_ID=

# Segredo usado para assinar os tokens JWT — OBRIGATÓRIO, o app não inicia sem ele.
# Gere um valor aleatório forte com: openssl rand -hex 32
JWT_SECRET=

# --- E-mail transacional (validação de cadastro e recuperação de senha) -----
# Provedor da API de envio: resend | brevo | sendgrid.
EMAIL_PROVIDER=resend
# Chave de API do provedor. SEM ELA (ou sem EMAIL_FROM) o portal continua no ar,
# mas o autocadastro volta a liberar o acesso na hora, sem validar o e-mail, e a
# recuperação de senha responde que está indisponível.
EMAIL_API_KEY=
# Remetente. Precisa ser de um domínio verificado no painel do provedor, senão
# a mensagem é recusada no envio ou cai em spam.
EMAIL_FROM=
EMAIL_FROM_NOME=Portal PBL — UNIVC
# URL pública do portal, usada para montar os links enviados por e-mail.
# Em produção: https://pbladmin.aguiaunivc.site — local: http://localhost:3000
APP_URL=http://localhost:3000
