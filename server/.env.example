PORT=4000

# Supabase Postgres (Settings > Database > Connection string, use o Session pooler)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# Google Drive (conta de serviço com acesso a um Drive Compartilhado do Workspace)
# Baixe o JSON da conta de serviço no Google Cloud Console e aponte o caminho aqui.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# Id da pasta (dentro do Drive Compartilhado) onde os arquivos serão gravados.
GOOGLE_DRIVE_FOLDER_ID=
