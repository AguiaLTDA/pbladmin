PORT=4000

# Supabase Postgres (Settings > Database > Connection string, use o Session pooler)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true

# Google Drive (conta de serviço com acesso a um Drive Compartilhado do Workspace)
# Dev local: baixe o JSON da conta de serviço no Google Cloud Console e aponte o caminho aqui.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json
# Produção (Render e afins, sem disco persistente para um arquivo): cole o CONTEÚDO
# inteiro do JSON aqui (uma linha só). Quando definida, tem prioridade sobre o arquivo acima.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
# Id da pasta (dentro do Drive Compartilhado) onde os arquivos serão gravados.
GOOGLE_DRIVE_FOLDER_ID=

# Segredo usado para assinar os tokens JWT — gere um valor aleatório forte em produção
# (ex.: openssl rand -hex 32). Sem isso, cai num valor padrão só adequado para dev local.
JWT_SECRET=
