# Variáveis de Ambiente para Conexão com o Supabase Cloud
# Copie os valores no painel do Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://sua-url-do-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# URL pública do backend Express (Render, Railway, etc.). Sem barra no final.
# Em dev local, se não definida, cai em http://localhost:4000/api.
VITE_API_BASE_URL=https://seu-backend.onrender.com/api
