# Variáveis de Ambiente para Conexão com o Supabase Cloud
# Copie os valores no painel do Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://sua-url-do-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Integração com o Google Sheets (cadastro de estudantes)
# URL /exec do Web App publicado a partir de google-apps-script/Codigo.gs
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/SEU_ID_DE_IMPLANTACAO/exec
# Mesmo valor da constante TOKEN dentro do Codigo.gs
VITE_GOOGLE_SHEETS_TOKEN=pbl-univc-2026
